.DS_Store
~$*

!/pricing/

# Job Generator: local-only state, not part of the codebase
/job-generator/test-output/
/job-generator/.config.json
/job-generator/node_modules/

# Job Generator: saved Job Drafts -- real client PII (name, address, notes,
# lockbox codes/screenshots) for shoots not yet finalized. Local-only,
# never synced anywhere, never committed.
/job-generator/drafts/

# Job Generator: real Dropbox credentials (App Key/Secret, refresh token,
# template id) -- NEVER commit this file. .env.example documents the
# required keys with no real values; copy it to .env and fill it in locally.
/job-generator/.env

# Job Generator: real Wave product-id map (wave-backend.js) -- not a secret
# by itself, but specific to Franky's real Wave business; wave-product-map.example.json documents the shape.
/job-generator/wave-product-map.json

# Feature Sheet Builder: local project + uploaded-photo storage
/feature-sheet-builder/data/

# Source reference PDF (large binary, not code)
/Jason FS.pdf

# Loose credential notes dropped in the repo root -- never commit these
/Secret and token.txt

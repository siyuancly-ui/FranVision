ADMIN_TOKEN=

# Cloudflare Stream (video hosting). CF_ACCOUNT_ID is not sensitive (also set
# as a `vars` entry in wrangler.jsonc for prod) but listed here too for local
# runs. CF_STREAM_API_TOKEN needs Stream:Edit permission on that account.

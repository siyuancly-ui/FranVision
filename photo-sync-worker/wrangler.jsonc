/**
 * FranVision Photo Sync Worker.
 *
 * A standalone Worker -- NOT the repo-root `wrangler.jsonc` (that one ships
 * the Feature Sheet Builder static site as the `franvision` Worker). This
 * one is deployed from inside `photo-sync-worker/`:
 *
 *   cd photo-sync-worker
 *   wrangler queues create photo-sync-jobs
 *   wrangler queues create photo-sync-dlq
 *   wrangler secret put DROPBOX_APP_KEY        # + APP_SECRET, REFRESH_TOKEN
 *   wrangler secret put SUPABASE_URL           # + SERVICE_ROLE_KEY
 *   wrangler secret put ADMIN_TOKEN
 *   wrangler secret put CF_STREAM_API_TOKEN    # Cloudflare Stream:Edit token
 *   wrangler deploy
 *
 * Requires the Workers Paid plan (Queues + higher subrequest limits).
 * See DESIGN.md and README.md.
 */
{
  "name": "franvision-photo-sync",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",

  "triggers": {
    // Reconciliation sweep -- catches Dropbox webhook notifications that
    // were lost (Dropbox drops them occasionally, or the Worker was mid-
    // deploy). Just enqueues a {type:"delta"}; cheap when nothing changed.
    "crons": ["*/2 * * * *"]
  },

  "queues": {
    "producers": [
      { "queue": "photo-sync-jobs", "binding": "SYNC_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "photo-sync-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "photo-sync-dlq"
      }
    ]
  },

  "vars": {
    // Where job folders live in Dropbox. Empty = account root (the app is
    // Full Dropbox and Job Generator creates job folders at root today).
    // If jobs are later consolidated under one parent, set it to e.g.
    // "/FranVision Jobs" -- no code change needed.
    "DROPBOX_JOBS_ROOT": "",

    // Sub-folders (directly under a job folder) whose images get mirrored.
    // Comma-separated, case-insensitive, surrounding spaces trimmed.
    // "MLS" was job-generator's folder name for this content until
    // 2026-09-12, when it was renamed to "HDR Photos" (pure naming
    // change there -- see job-generator/CLAUDE.md's "MLS renamed to HDR
    // Photos" decision). Both names are listed here so jobs created
    // before and after that rename keep syncing -- do not drop "MLS"
    // until no job with the old folder name is still in active use.
    "SYNC_FOLDERS": "MLS,HDR Photos,Virtual Staging,Floorplan,Local Report",

    // Sub-folders whose videos get copied into Cloudflare Stream. Same
    // comma-separated/case-insensitive parsing as SYNC_FOLDERS.
    "VIDEO_SYNC_FOLDERS": "Video,VLOG",

    // Cloudflare account id that owns the Stream product used for video
    // hosting. Not sensitive -- the API token (a secret) is what's guarded.
    "CF_ACCOUNT_ID": "6f3c289ac50b8015fed5082696db622b",

    // Dropbox get_thumbnail size for the Gallery / Supabase thumbnail.
    "THUMB_SIZE": "w1024h768",

    // Bigger render for the downloadable "MLS for download" delivery set
    // written back to Dropbox. w2048h1536 is Dropbox's largest (a 3:2
    // landscape comes out 2048x1365, ~0.4-0.9 MB).
    "DOWNLOAD_THUMB_SIZE": "w2048h1536",

    // PropertyGroupTemplate that carries the hidden `jobId` on each job
    // folder (registered by the Job Generator setup script).
    "DROPBOX_TEMPLATE_ID": "ptid:R599LCPosWEAAAAAAAAIFA",

    // Sub-folders that ALSO get a downloadable compressed copy written back
    // into Dropbox (the "MLS for download" delivery set). Subset of
    // SYNC_FOLDERS. The 1024 bytes are reused -- compressed once. Same
    // "MLS"->"HDR Photos" rename note as SYNC_FOLDERS above applies here.
    // DOWNLOAD_SUBFOLDER itself ("MLS for download") is a DIFFERENT,
    // unrelated name (Photo Sync Worker's own derived-copy folder) --
    // it is NOT part of the job-generator rename and stays as-is.
    "DOWNLOAD_SET_FOLDERS": "MLS,HDR Photos",
    "DOWNLOAD_SUBFOLDER": "MLS for download",

    // Safety cap: max delta entries pulled per queue message before the
    // cursor is saved and processing continues in a fresh message.
    "MAX_DELTA_ENTRIES_PER_RUN": "2000"
  }
}

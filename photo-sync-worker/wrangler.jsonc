/**
 * FranVision Photo Sync Worker.
 *
 * A standalone Worker -- NOT the repo-root `wrangler.jsonc` (that one ships
 * the Feature Sheet Builder static site as the `franvision` Worker). This
 * one is deployed from inside `photo-sync-worker/`:
 *
 *   cd photo-sync-worker
 *   wrangler queues create photo-sync-jobs
 *   wrangler queues create photo-sync-dlq
 *   wrangler secret put DROPBOX_APP_KEY        # + APP_SECRET, REFRESH_TOKEN
 *   wrangler secret put SUPABASE_URL           # + SERVICE_ROLE_KEY
 *   wrangler secret put ADMIN_TOKEN
 *   wrangler secret put CF_STREAM_API_TOKEN    # Cloudflare Stream:Edit token
 *   wrangler deploy
 *
 * Requires the Workers Paid plan (Queues + higher subrequest limits).
 * See DESIGN.md and README.md.
 */
{
  "name": "franvision-photo-sync",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",

  // GET /zip streams a whole Job's photos through the CRC-32 in zip.js; the
  // 30s default CPU budget is too tight for a few hundred MB of originals.
  "limits": { "cpu_ms": 300000 },

  "triggers": {
    // Reconciliation sweep -- catches Dropbox webhook notifications that
    // were lost (Dropbox drops them occasionally, or the Worker was mid-
    // deploy). Just enqueues a {type:"delta"}; cheap when nothing changed.
    "crons": ["*/2 * * * *"]
  },

  "queues": {
    "producers": [
      { "queue": "photo-sync-jobs", "binding": "SYNC_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "photo-sync-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "photo-sync-dlq"
      }
    ]
  },

  "vars": {
    // Where job folders live in Dropbox. Empty = account root (the app is
    // Full Dropbox and Job Generator creates job folders at root today).
    // If jobs are later consolidated under one parent, set it to e.g.
    // "/FranVision Jobs" -- no code change needed.
    "DROPBOX_JOBS_ROOT": "",

    // Sub-folders (directly under a job folder) whose images get mirrored.
    // Comma-separated, case-insensitive, surrounding spaces trimmed.
    // "MLS" was renamed to "HDR Photos" by Job Generator on 2026-09-12 --
    // both names stay listed so pre-rename jobs (still named "MLS" on
    // Dropbox) keep syncing alongside new "HDR Photos" jobs.
    //
    // "Cover&Closing" / "Callout" are delivery-page's manual-override
    // folders (see delivery-page/CLAUDE.md and
    // franvision-delivery-page-design-spec.md) -- Job Generator doesn't
    // create these by default yet (deferred), but syncing them here means a
    // manually-created Dropbox folder with the same name works immediately,
    // no photo-sync-worker deploy needed once job-generator catches up.
    // "Callout" is expected to usually be nested under "HDR Photos"
    // (matchAncestorFolder finds it at any depth) -- "Cover&Closing" is
    // top-level, a sibling of the other folders.
    //
    // "Cover&Closing" (2026-09-17, merges the former separate "Cover" and
    // "Closing" folders from 2026-09-15/16) holds up to two photos: the
    // lowest-numbered filename becomes delivery-page's cover/hero override,
    // the highest-numbered becomes its closing override (see
    // delivery-page/src/render.js#buildDeliveryModel).
    "SYNC_FOLDERS": "MLS,HDR Photos,Virtual Staging,Floorplan,Local Report,Cover&Closing,Callout",

    // Sub-folders whose videos get copied into Cloudflare Stream. Same
    // comma-separated/case-insensitive parsing as SYNC_FOLDERS.
    "VIDEO_SYNC_FOLDERS": "Video,VLOG",

    // The one well-known text file, directly at a job folder's root (not
    // nested in any sub-folder), whose content is the Floor Tour or 3D Tour
    // URL for delivery-page (see tour-link-sync.js). One file, one link --
    // both providers render identically, so there's no per-provider name/
    // type to configure here, just this single filename.
    "TOUR_LINK_FILENAME": "Tour Link.txt",

    // Cloudflare account id that owns the Stream product used for video
    // hosting. Not sensitive -- the API token (a secret) is what's guarded.
    "CF_ACCOUNT_ID": "6f3c289ac50b8015fed5082696db622b",

    // Dropbox get_thumbnail size for the Gallery / Supabase thumbnail.
    "THUMB_SIZE": "w1024h768",

    // Bigger render for the downloadable "MLS for download" delivery set
    // written back to Dropbox. w2048h1536 is Dropbox's largest (a 3:2
    // landscape comes out 2048x1365, ~0.4-0.9 MB).
    "DOWNLOAD_THUMB_SIZE": "w2048h1536",

    // PropertyGroupTemplate that carries the hidden `jobId` on each job
    // folder (registered by the Job Generator setup script).
    "DROPBOX_TEMPLATE_ID": "ptid:R599LCPosWEAAAAAAAAIFA",

    // Sub-folders that ALSO get a downloadable compressed copy written back
    // into Dropbox (the "MLS for download" delivery set). Subset of
    // SYNC_FOLDERS. The 1024 bytes are reused -- compressed once. Same
    // "MLS"->"HDR Photos" rename note as SYNC_FOLDERS above applies here.
    // DOWNLOAD_SUBFOLDER itself ("MLS for download") is a DIFFERENT,
    // unrelated name (Photo Sync Worker's own derived-copy folder) --
    // it is NOT part of the job-generator rename and stays as-is.
    "DOWNLOAD_SET_FOLDERS": "MLS,HDR Photos",
    // Folders nested UNDER a download-set folder that get a copy in the same-named
    // sub-folder of DOWNLOAD_SUBFOLDER (HDR Photos/Callout/x.jpg -> MLS for download/Callout/x.jpg).
    "DOWNLOAD_NESTED_FOLDERS": "Callout",
    "DOWNLOAD_SUBFOLDER": "MLS for download",

    // Sub-folders that ALSO get a large (DOWNLOAD_THUMB_SIZE) render
    // uploaded to Supabase Storage as <photoId>_large.jpg, for delivery-
    // page's full-bleed sections (hero/closing/aerial/neighborhood-report/
    // floor-plan). "Floorplan" added 2026-09-18 alongside delivery-page's
    // new Floor Plan section -- a floor plan is a technical diagram (room
    // labels, measurements), so legibility benefits from the large render
    // even more than a regular photo does. Deliberately NOT the main
    // gallery (MLS/HDR Photos) -- those stay small-only; see
    // photo-sync-worker/CLAUDE.md for why.
    "LARGE_THUMB_FOLDERS": "Cover&Closing,Callout,Local Report,Floorplan",

    // Subset of LARGE_THUMB_FOLDERS that gets the TRUE original file bytes
    // instead of a Dropbox-thumbnail-API render (2026-09-18). Floorplan
    // exports are already small (a diagram/screenshot, not a DSLR photo),
    // so a w2048h1536 derivative just adds JPEG re-compression -- and if
    // the source isn't already a JPEG, re-encoding it as one too -- for no
    // real size benefit. Every other LARGE_THUMB_FOLDERS folder is left off
    // this list on purpose (a real estate photo's original can be tens of
    // MB, which is exactly what the w2048h1536 cap exists to avoid).
    "ORIGINAL_RENDER_FOLDERS": "Floorplan",

    // Safety cap: max delta entries pulled per queue message before the
    // cursor is saved and processing continues in a fresh message.
    "MAX_DELTA_ENTRIES_PER_RUN": "2000"
  }
}

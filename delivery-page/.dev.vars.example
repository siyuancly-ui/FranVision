# Copy to .dev.vars (gitignored) and fill in for local `wrangler dev` runs.
# Production uses `wrangler secret put` for each of these -- never a file.

# Same Supabase project photo-sync-worker writes to.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Guards POST /admin/jobs/<jobId> (sets address/tourUrl/tourType).
ADMIN_TOKEN=

# Standalone Gallery page (src/gallery.js). PHOTO_SYNC_TOKEN is
# photo-sync-worker's GALLERY_TOKEN. Locally there is no service binding, so
# point PHOTO_SYNC_URL at a running/deployed photo-sync-worker.
PHOTO_SYNC_TOKEN=
PHOTO_SYNC_URL=
